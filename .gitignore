# Root .gitignore for job-platform monorepo

# IDE and Editor settings
.idea/
.vscode/
*.iml
*.swp
*.swo

# OS files
.DS_Store
Thumbs.db

# Log files
*.log

# Python / Virtual Environment
.venv/
venv/
env/
__pycache__/
*.py[cod]
.python-version

# Node dependency directories
node_modules/

# Build outputs
target/
dist/
build/
